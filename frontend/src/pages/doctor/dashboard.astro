    // --- Render Baseline Comparison Table ---
    function renderBaselineTable(curr, base) {
      const tbody = document.getElementById("baseline-comparison-table-body");
      if (!tbody) return;

      const rows = [
        { name: "Blood Glucose", key: "glucose", unit: "mg/dL", norm: "< 100 mg/dL (ADA Fasting)" },
        { name: "Systolic BP", key: "blood_pressure_systolic", unit: "mmHg", norm: "< 120 mmHg (AHA Normal)" },
        { name: "Diastolic BP", key: "blood_pressure_diastolic", unit: "mmHg", norm: "< 80 mmHg (AHA Normal)" },
        { name: "Resting Heart Rate", key: "heart_rate", unit: "bpm", norm: "60 - 90 bpm" },
        { name: "Blood Oxygen SpO2", key: "spo2", unit: "%", norm: "95 - 100%" },
        { name: "Daily Activity", key: "activity_steps", unit: "steps", norm: "> 7,000 steps/day" }
      ];

      tbody.innerHTML = rows.map(r => {
        const cVal = curr[r.key] || 0;
        const bVal = base[r.key] || 0;
        const delta = bVal > 0 ? (((cVal - bVal) / bVal) * 100).toFixed(1) : 0;
        const isAnomaly = (r.key === 'glucose' && Math.abs(delta) >= 15) || 
                          (r.key === 'blood_pressure_systolic' && cVal >= 135) ||
                          (r.key === 'spo2' && cVal < 95);

        return `
          <tr class="hover:bg-[#fafafa]">
            <td class="py-2.5 font-medium text-[#171717]">${r.name}</td>
            <td class="py-2.5 font-bold">${cVal} ${r.unit}</td>
            <td class="py-2.5 text-[#737373]">${bVal} ${r.unit}</td>
            <td class="py-2.5 ${Math.abs(delta) > 15 ? 'text-[#ee0000] font-bold' : 'text-[#4d4d4d]'}">
              ${delta >= 0 ? '+' : ''}${delta}%
            </td>
            <td class="py-2.5 text-[#737373]">${r.norm}</td>
            <td class="py-2.5">
              ${isAnomaly 
                ? '<span class="px-1.5 py-0.5 rounded bg-[#ee0000]/10 text-[#ee0000] text-[10px] font-bold">Personal Spike</span>' 
                : '<span class="px-1.5 py-0.5 rounded bg-[#10b981]/10 text-[#059669] text-[10px]">Within Bounds</span>'}
            </td>
          </tr>
        `;
      }).join("");
    }

    // --- Render XAI SHAP Explanation ---
    function renderXAIExplanation(p) {
      const summaryEl = document.getElementById("xai-plain-summary");
      const barsContainer = document.getElementById("shap-bars-container");
      const caregiverCard = document.getElementById("caregiver-dispatch-status");
      const caregiverMsg = document.getElementById("caregiver-dispatch-message");

      const curr = p.current_vitals || {};
      const base = p.baseline_vitals || {};
      const glucDelta = base.glucose ? (((curr.glucose - base.glucose) / base.glucose) * 100).toFixed(1) : 0;

      let plainSummary = "";
      let shapFactors = [];

      if ((p.risk_tier || "").toUpperCase() === "URGENT") {
        plainSummary = `Risk is URGENT (${(p.latest_risk_score*100).toFixed(1)}%) mainly due to: Blood glucose elevated at ${curr.glucose} mg/dL (+${glucDelta}% above personal baseline of ${base.glucose}), elevated blood pressure (${Math.round(curr.blood_pressure_systolic)}/${Math.round(curr.blood_pressure_diastolic)} mmHg), and high glucose variability.`;
        shapFactors = [
          { feat: "Blood Glucose Deviation", val: "+0.48", width: "88%", color: "bg-[#ee0000]" },
          { feat: "Daily Physical Inactivity", val: "+0.22", width: "54%", color: "bg-[#ee0000]" },
          { feat: "Systolic Blood Pressure", val: "+0.18", width: "42%", color: "bg-[#f5a623]" },
          { feat: "Elevated BMI", val: "+0.12", width: "30%", color: "bg-[#f5a623]" }
        ];
        caregiverCard.classList.remove("hidden");
        caregiverMsg.textContent = `SMS alert sent to ${p.caregiver_name} (${p.caregiver_contact}): "Urgent metabolic spike detected for ${p.name}. Clinician notified."`;
      } else if ((p.risk_tier || "").toUpperCase() === "MODERATE") {
        plainSummary = `Risk is MODERATE (${(p.latest_risk_score*100).toFixed(1)}%) mainly due to: Pre-diabetic glucose elevation at ${curr.glucose} mg/dL (+${glucDelta}% vs baseline of ${base.glucose}), mild blood pressure rise, and suboptimal daily steps.`;
        shapFactors = [
          { feat: "Glucose Pre-diabetic Shift", val: "+0.26", width: "52%", color: "bg-[#f5a623]" },
          { feat: "BMI Adiposity Factor", val: "+0.14", width: "34%", color: "bg-[#f5a623]" },
          { feat: "Physical Activity Deficit", val: "+0.11", width: "26%", color: "bg-[#f5a623]" },
          { feat: "Normal SpO2 Saturation", val: "-0.08", width: "18%", color: "bg-[#10b981]" }
        ];
        caregiverCard.classList.add("hidden");
      } else {
        plainSummary = `Risk is LOW (${(p.latest_risk_score*100).toFixed(1)}%): All monitored vitals are within personal target baseline. High daily activity and healthy BMI act as protective metabolic factors.`;
        shapFactors = [
          { feat: "Optimal Physical Activity", val: "-0.32", width: "65%", color: "bg-[#10b981]" },
          { feat: "Euglycemic Blood Sugar", val: "-0.28", width: "56%", color: "bg-[#10b981]" },
          { feat: "Normotensive BP", val: "-0.15", width: "32%", color: "bg-[#10b981]" },
          { feat: "Normal BMI", val: "-0.12", width: "24%", color: "bg-[#10b981]" }
        ];
        caregiverCard.classList.add("hidden");
      }

      summaryEl.textContent = plainSummary;

      barsContainer.innerHTML = shapFactors.map(s => `
        <div>
          <div class="flex justify-between text-[11px] font-mono mb-0.5">
            <span class="text-[#4d4d4d]">${s.feat}</span>
            <span class="font-bold text-[#171717]">${s.val} SHAP</span>
          </div>
          <div class="w-full bg-[#f2f2f2] rounded-full h-1.5 overflow-hidden">
            <div class="${s.color} h-1.5 rounded-full" style="width: ${s.width}"></div>
          </div>
        </div>
      `).join("");
    }

    // --- Render SVG Trend Chart ---
    function renderSVGChart(p) {
      const svg = document.getElementById("vitals-chart-svg");
      if (!svg) return;

      const baseGluc = p.baseline_vitals?.glucose || 100;
      const currGluc = p.current_vitals?.glucose || 110;

      const points = [];
      for (let i = 0; i < 12; i++) {
        const ratio = i / 11;
        const val = baseGluc + (currGluc - baseGluc) * Math.pow(ratio, 1.4) + (Math.sin(i * 0.9) * 4);
        points.push(val);
      }

      const minVal = 60;
      const maxVal = 240;
      const width = 600;
      const height = 180;

      function getY(v) {
        return height - ((v - minVal) / (maxVal - minVal)) * height;
      }

      const pathData = points.map((v, i) => {
        const x = (i / 11) * width;
        const y = getY(v);
        return `${i === 0 ? 'M' : 'L'} ${x} ${y}`;
      }).join(" ");

      const baselineY = getY(baseGluc);
      const adaLimitY = getY(140);
      const urgentLimitY = getY(180);

      svg.innerHTML = `
        <defs>
          <linearGradient id="chartGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="#ee0000" stop-opacity="0.25"/>
            <stop offset="100%" stop-color="#ee0000" stop-opacity="0.0"/>
          </linearGradient>
        </defs>

        <line x1="0" y1="${urgentLimitY}" x2="${width}" y2="${urgentLimitY}" stroke="#ee0000" stroke-dasharray="4,4" stroke-opacity="0.4" stroke-width="1"/>
        <text x="8" y="${urgentLimitY - 4}" fill="#ee0000" font-size="9" font-family="Geist Mono" opacity="0.8">Urgent Cutoff (180 mg/dL)</text>

        <line x1="0" y1="${adaLimitY}" x2="${width}" y2="${adaLimitY}" stroke="#8f8f8f" stroke-dasharray="4,4" stroke-opacity="0.4" stroke-width="1"/>
        <text x="8" y="${adaLimitY - 4}" fill="#8f8f8f" font-size="9" font-family="Geist Mono">ADA Postprandial Limit (140 mg/dL)</text>

        <line x1="0" y1="${baselineY}" x2="${width}" y2="${baselineY}" stroke="#0070f3" stroke-dasharray="3,3" stroke-width="1.5" stroke-opacity="0.7"/>
        <text x="${width - 165}" y="${baselineY - 4}" fill="#0070f3" font-size="9" font-family="Geist Mono" font-weight="bold">Personal Baseline (${baseGluc.toFixed(0)} mg/dL)</text>

        <path d="${pathData} L ${width} ${height} L 0 ${height} Z" fill="url(#chartGrad)"/>
        <path d="${pathData}" fill="none" stroke="${currGluc > 170 ? '#ee0000' : (currGluc > 115 ? '#f5a623' : '#10b981')}" stroke-width="2.5" stroke-linecap="round"/>

        ${points.map((v, i) => {
          const x = (i / 11) * width;
          const y = getY(v);
          return `<circle cx="${x}" cy="${y}" r="${i === 11 ? 5 : 3}" fill="${i === 11 ? '#ee0000' : '#171717'}" stroke="#fff" stroke-width="2"/>`;
        }).join("")}
      `;
    }

    // --- Render Alert Feed List ---
    function renderAlertFeed(filter = "all") {
      const container = document.getElementById("alert-feed-list");
      if (!container) return;

      let filtered = alertsLog;
      if (filter !== "all") {
        filtered = alertsLog.filter(a => a.severity.toLowerCase() === filter.toLowerCase());
      }

      container.innerHTML = filtered.map(a => {
        let badgeClass = "bg-[#10b981]/10 text-[#059669] border-[#10b981]/20";
        if (a.severity.toLowerCase() === "urgent") badgeClass = "bg-[#ee0000]/10 text-[#ee0000] border-[#ee0000]/20";
        else if (a.severity.toLowerCase() === "moderate") badgeClass = "bg-[#f5a623]/10 text-[#d97706] border-[#f5a623]/20";

        return `
          <div class="p-2.5 rounded-xl border border-[#ebebeb] bg-white hover:bg-[#fafafa] transition-all space-y-1.5 shadow-2xs">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-[#171717]">${a.patient_name}</span>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-mono border ${badgeClass}">${a.severity.toUpperCase()}</span>
            </div>
            <p class="text-[11px] text-[#4d4d4d] leading-relaxed">${a.summary}</p>
            <div class="flex items-center justify-between pt-1 border-t border-[#f5f5f5] text-[10px] font-mono text-[#737373]">
              <span>${a.time}</span>
              ${a.acknowledged 
                ? '<span class="text-[#059669] font-bold">✓ Acknowledged</span>' 
                : `<button class="btn-ack px-2 py-0.5 rounded bg-[#171717] text-white hover:bg-black font-sans font-medium" data-id="${a.alert_id}">Acknowledge</button>`}
            </div>
          </div>
        `;
      }).join("");

      // Attach ack event
      container.querySelectorAll(".btn-ack").forEach(btn => {
        btn.addEventListener("click", () => {
          const id = btn.getAttribute("data-id");
          const alert = alertsLog.find(x => x.alert_id === id);
          if (alert) alert.acknowledged = true;
          fetch(`${API_BASE}/api/alerts/${id}/acknowledge`, { 
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ note: "Acknowledged via Doctor Dashboard", doctor_name: "Dr. Alex Carter" })
          }).catch(() => {});
          renderAlertFeed(filter);
        });
      });
    }

    // Attach Alert Filter Buttons
    document.querySelectorAll(".alert-filter-btn").forEach(btn => {
      btn.addEventListener("click", () => {
        document.querySelectorAll(".alert-filter-btn").forEach(b => {
          b.className = "alert-filter-btn px-2 py-0.5 rounded bg-[#f2f2f2] text-[#4d4d4d]";
        });
        btn.className = "alert-filter-btn px-2 py-0.5 rounded bg-[#171717] text-white";
        renderAlertFeed(btn.getAttribute("data-filter"));
      });
    });

    // --- Clinician Notes Functions ---
    function renderClinicianNotesHistory() {
      const container = document.getElementById("clinician-notes-history");
      if (!container) return;
      const notes = patientNotes[activePatientId] || [];
      if (notes.length === 0) {
        container.innerHTML = '<div class="text-[11px] text-[#a3a3a3] italic">No clinical notes recorded yet for this patient.</div>';
        return;
      }
      container.innerHTML = notes.map(n => `
        <div class="p-2.5 rounded-lg bg-[#fafafa] border border-[#ebebeb] space-y-1">
          <div class="flex items-center justify-between text-[10px] text-[#737373]">
            <span class="font-bold text-[#171717]">${n.doctor || 'Dr. Alex Carter'}</span>
            <span class="font-mono">${n.time || 'Just now'}</span>
          </div>
          <p class="text-xs text-[#333] leading-relaxed">${n.text || n.content}</p>
        </div>
      `).join("");
    }

    // Save Clinical Note button
    document.getElementById("btn-save-note")?.addEventListener("click", async () => {
      const noteInput = document.getElementById("clinician-note-input");
      const noteText = noteInput.value.trim();
      const statusLabel = document.getElementById("note-save-status");
      if (!noteText) return;

      if (!patientNotes[activePatientId]) patientNotes[activePatientId] = [];
      patientNotes[activePatientId].unshift({
        doctor: "Dr. Alex Carter",
        time: "Just now",
        text: noteText
      });

      // Post to backend
      fetch(`${API_BASE}/api/doctor/patients/${activePatientId}/notes`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ note: noteText, doctor_name: "Dr. Alex Carter" })
      }).catch(() => {});

      noteInput.value = "";
      renderClinicianNotesHistory();
      statusLabel.textContent = "✓ Note saved to patient audit file";
      setTimeout(() => { statusLabel.textContent = ""; }, 3000);
      showToast("Clinical Note Saved", `Note added to ${activePatientId}'s record.`, "normal");
    });

    // Quick notes chips
    document.querySelectorAll(".btn-quick-note").forEach(btn => {
      btn.addEventListener("click", () => {
        document.getElementById("clinician-note-input").value = btn.getAttribute("data-note");
      });
    });

    // Acknowledge Active Alert button
    document.getElementById("btn-ack-active-alert")?.addEventListener("click", () => {
      const targetAlert = alertsLog.find(a => a.patient_id === activePatientId && !a.acknowledged);
      if (targetAlert) {
        targetAlert.acknowledged = true;
        fetch(`${API_BASE}/api/alerts/${targetAlert.alert_id}/acknowledge`, { 
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ note: "Acknowledged via Clinician Action Panel", doctor_name: "Dr. Alex Carter" })
        }).catch(() => {});
        renderAlertFeed();
        showToast("Alert Acknowledged", `Urgent flag for ${targetAlert.patient_name} marked as reviewed.`, "normal");
      } else {
        showToast("No Pending Alerts", `All alerts for this patient are already acknowledged.`, "normal");
      }
    });

    // --- Toast Notification Helper ---
    function showToast(title, message, tier = "urgent") {
      const container = document.getElementById("toast-container");
      if (!container) return;

      const toast = document.createElement("div");
      toast.className = `p-4 rounded-xl border shadow-lg backdrop-blur-md pointer-events-auto transform transition-all duration-300 translate-y-2 bg-white ${tier === 'urgent' ? 'border-[#ee0000]' : (tier === 'moderate' ? 'border-[#f5a623]' : 'border-[#10b981]')}`;
      const badgeClass = tier === 'urgent' ? 'text-[#ee0000] bg-[#ee0000]/10' : (tier === 'moderate' ? 'text-[#f5a623] bg-[#f5a623]/10' : 'text-[#059669] bg-[#10b981]/10');
      
      toast.innerHTML = `
        <div class="flex items-start justify-between">
          <div class="flex items-center space-x-2">
            <span class="w-2 h-2 rounded-full ${tier === 'urgent' ? 'bg-[#ee0000] animate-ping' : 'bg-[#10b981]'}"></span>
            <span class="text-xs font-mono font-bold uppercase ${badgeClass} px-1.5 py-0.5 rounded">${tier} ALERT</span>
          </div>
          <button class="text-xs text-[#737373] hover:text-black" onclick="this.parentElement.parentElement.remove()">✕</button>
        </div>
        <div class="text-xs font-bold text-[#171717] mt-1.5">${title}</div>
        <p class="text-[11px] text-[#4d4d4d] mt-0.5 leading-relaxed">${message}</p>
      `;

      container.appendChild(toast);
      setTimeout(() => { toast.remove(); }, 6000);
    }

    // --- Live Simulation & API Synchronization ---
    async function syncFromBackend() {
      try {
        const resp = await fetch(`${API_BASE}/api/doctor/patients`);
        if (resp.ok) {
          const apiPatients = await resp.json();
          if (apiPatients && apiPatients.length > 0) {
            patientsData = apiPatients;
            renderTriageList();
            renderActivePatientDetail();
          }
        }
      } catch (e) {}
    }

    function simulateTick() {
      simTick++;
      patientsData.forEach(p => {
        const wave = Math.sin(simTick * 0.3);
        if (p.current_vitals) {
          if (p.patient_id === "P003") {
            p.current_vitals.glucose = Number((190 + wave * 6 + (Math.random() * 3)).toFixed(1));
            p.current_vitals.heart_rate = Math.round(84 + wave * 3);
          } else if (p.patient_id === "P002") {
            p.current_vitals.glucose = Number((124 + wave * 4 + (Math.random() * 2)).toFixed(1));
          } else if (p.patient_id === "P005") {
            p.current_vitals.glucose = Number((130 + wave * 3 + (Math.random() * 2)).toFixed(1));
          } else {
            p.current_vitals.glucose = Number((90 + wave * 2 + (Math.random() * 1.5)).toFixed(1));
          }
        }
      });
      renderActivePatientDetail();
    }

    // Toggle Simulation Button
    document.getElementById("btn-toggle-sim")?.addEventListener("click", () => {
      isSimulating = !isSimulating;
      const simStatusLabel = document.getElementById("sim-status-label");
      const iconSimPause = document.getElementById("icon-sim-pause");
      if (isSimulating) {
        simStatusLabel.textContent = "Simulating Feed";
        iconSimPause.className = "w-3.5 h-3.5 mr-1.5 text-[#10b981]";
        simIntervalTimer = setInterval(simulateTick, 3500);
      } else {
        simStatusLabel.textContent = "Feed Paused";
        iconSimPause.className = "w-3.5 h-3.5 mr-1.5 text-[#a3a3a3]";
        clearInterval(simIntervalTimer);
      }
    });

    // Trigger Scenario Presets
    async function triggerPreset(scenarioType) {
      try {
        const resp = await fetch(`${API_BASE}/api/simulator/scenario`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ scenario: scenarioType, patient_id: activePatientId })
        });
        if (resp.ok) {
          const res = await resp.json();
          const target = patientsData.find(x => x.patient_id === activePatientId) || patientsData[0];
          target.latest_risk_score = res.risk_score;
          target.risk_tier = res.severity;
          target.current_vitals.glucose = scenarioType === "critical" ? 218.4 : (scenarioType === "spike" ? 138.0 : 90.5);
          
          if (scenarioType === "critical") {
            const newAlert = {
              alert_id: res.alert_id || ("ALT-" + Math.floor(Math.random() * 9000)),
              patient_id: target.patient_id,
              patient_name: target.name,
              severity: "Urgent",
              risk_score: res.risk_score,
              time: "Just now",
              summary: `Critical acute glucose spike to ${target.current_vitals.glucose} mg/dL. Emergency caregiver notified.`,
              caregiver_notified: true,
              acknowledged: false
            };
            alertsLog.unshift(newAlert);
            renderAlertFeed();
            showToast(`Critical Surge: ${target.name}`, `Emergency caregiver SMS dispatched to ${target.caregiver_name}.`, "urgent");
          } else if (scenarioType === "spike") {
            showToast(`Spike Warning: ${target.name}`, `Glucose elevated to 138.0 mg/dL (+22% vs baseline).`, "moderate");
          } else {
            showToast(`Stable Telemetry: ${target.name}`, `Readings within personal baseline range.`, "normal");
          }

          renderTriageList();
          renderActivePatientDetail();
        }
      } catch (e) {
        // Fallback local injection
        const target = patientsData.find(x => x.patient_id === activePatientId) || patientsData[0];
        if (scenarioType === "critical") {
          target.current_vitals.glucose = 218.4;
          target.current_vitals.blood_pressure_systolic = 168.0;
          target.latest_risk_score = 0.942;
          target.risk_tier = "Urgent";
          showToast(`Critical Surge: ${target.name}`, `Glucose spiked to 218.4 mg/dL.`, "urgent");
        } else if (scenarioType === "spike") {
          target.current_vitals.glucose = 138.0;
          target.latest_risk_score = 0.58;
          target.risk_tier = "Moderate";
          showToast(`Spike Warning: ${target.name}`, `Glucose elevated to 138.0 mg/dL.`, "moderate");
        } else {
          target.current_vitals.glucose = 90.5;
          target.latest_risk_score = 0.09;
          target.risk_tier = "Low";
          showToast(`Stable: ${target.name}`, `Normal baseline readings.`, "normal");
        }
        renderTriageList();
        renderActivePatientDetail();
      }
    }

    document.getElementById("btn-scenario-stable")?.addEventListener("click", () => triggerPreset("stable"));
    document.getElementById("btn-scenario-spike")?.addEventListener("click", () => triggerPreset("spike"));
    document.getElementById("btn-scenario-critical")?.addEventListener("click", () => triggerPreset("critical"));
    document.getElementById("btn-scenario-stable-m")?.addEventListener("click", () => triggerPreset("stable"));
    document.getElementById("btn-scenario-spike-m")?.addEventListener("click", () => triggerPreset("spike"));
    document.getElementById("btn-scenario-critical-m")?.addEventListener("click", () => triggerPreset("critical"));

    // WebSocket Setup
    function setupWebSocket() {
      try {
        const ws = new WebSocket("ws://localhost:8000/ws/monitoring");
        ws.onmessage = (event) => {
          const data = JSON.parse(event.data);
          if (data.event === "VITALS_UPDATE") {
            const idx = patientsData.findIndex(x => x.patient_id === data.patient_id);
            if (idx >= 0) {
              patientsData[idx].current_vitals = data.vitals;
              patientsData[idx].latest_risk_score = data.risk_score;
              patientsData[idx].risk_tier = data.severity;
              renderTriageList();
              if (data.patient_id === activePatientId) {
                renderActivePatientDetail();
              }
            }
            if (data.alert) {
              alertsLog.unshift({
                alert_id: data.alert.alert_id,
                patient_id: data.alert.patient_id,
                patient_name: data.alert.patient_name,
                severity: data.alert.severity,
                risk_score: data.alert.risk_score,
                time: "Just now",
                summary: data.alert.summary_message,
                caregiver_notified: data.alert.caregiver_notified,
                acknowledged: false
              });
              renderAlertFeed();
              if (data.alert.severity === "Urgent") {
                showToast(`Urgent: ${data.alert.patient_name}`, data.alert.summary_message, "urgent");
              }
            }
          }
        };
      } catch (e) {}
    }

    // --- Page Initialization ---
    document.addEventListener("DOMContentLoaded", () => {
      enforceDoctorAuth();
      renderTriageList();
      renderActivePatientDetail();
      renderAlertFeed();

      simIntervalTimer = setInterval(simulateTick, 3500);
      syncFromBackend();
      setupWebSocket();
    });
  </script>
</Layout>
