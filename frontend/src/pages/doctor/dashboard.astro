---
import Layout from '../../layouts/Layout.astro';
import fs from 'node:fs';
import path from 'node:path';

// Server-side preload seed data if available
let seedPatients = [];
try {
  const seedPath = path.resolve('../data/seed_patients.json');
  if (fs.existsSync(seedPath)) {
    seedPatients = JSON.parse(fs.readFileSync(seedPath, 'utf-8'));
  }
} catch (e) {
  // Client script will fall back to embedded data
}
---

<Layout title="VitalGuard AI — Doctor Web Dashboard & Clinical Triage">
  
  <!-- Top Navigation Header -->
  <header class="sticky top-0 z-50 bg-[#fafafa]/95 backdrop-blur-md border-b border-[#ebebeb]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
      
      <!-- Brand & Status (Clean Branding - No Capstone Label) -->
      <div class="flex items-center space-x-3">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-[#059669] to-[#10b981] flex items-center justify-center text-white shadow-sm ring-1 ring-[#10b981]/30">
          <!-- Healthcare pulse Lucide icon -->
          <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h2l1-2.5 2 5.5 1-3h3"></path>
          </svg>
        </div>
        <div>
          <div class="flex items-center space-x-2">
            <span class="font-bold text-sm tracking-tight text-[#171717]">VitalGuard AI</span>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-medium bg-[#10b981]/10 text-[#059669] border border-[#10b981]/20">
              <span class="w-1.5 h-1.5 rounded-full bg-[#10b981] mr-1.5 animate-pulse-dot"></span>
              LIVE STREAM
            </span>
          </div>
          <p class="text-[11px] text-[#737373] font-medium hidden sm:block">AI-Powered Remote Patient Monitoring</p>
        </div>
      </div>

      <!-- Center: Simulation Controls & Clinical Presets -->
      <div class="hidden md:flex items-center space-x-2 bg-white px-2.5 py-1.5 rounded-xl border border-[#ebebeb] shadow-xs">
        <span class="text-[10px] font-mono uppercase text-[#737373] font-semibold pr-1 border-r border-[#ebebeb]">Sim Stream</span>
        
        <button id="btn-toggle-sim" class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-medium border border-[#ebebeb] bg-[#fafafa] text-[#171717] hover:bg-[#f5f5f5] transition-colors shadow-2xs">
          <svg id="icon-sim-pause" class="w-3.5 h-3.5 mr-1.5 text-[#10b981]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6m7-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          <span id="sim-status-label">Simulating Feed</span>
        </button>

        <!-- Scenario Presets -->
        <div class="flex items-center space-x-1 pl-1">
          <button id="btn-scenario-stable" class="px-2 py-1 rounded text-[11px] font-medium bg-[#10b981]/10 text-[#059669] hover:bg-[#10b981]/20 transition-colors" title="Inject Scenario 1: Stable Patient Readings">
            🟢 Stable
          </button>
          <button id="btn-scenario-spike" class="px-2 py-1 rounded text-[11px] font-medium bg-[#f5a623]/15 text-[#d97706] hover:bg-[#f5a623]/25 transition-colors" title="Inject Scenario 2: Pre-Diabetic Spike Warning">
            🟡 Spike Warning
          </button>
          <button id="btn-scenario-critical" class="px-2 py-1 rounded text-[11px] font-medium bg-[#ee0000]/10 text-[#dc2626] hover:bg-[#ee0000]/20 font-bold transition-colors" title="Inject Scenario 3: Critical Acute Alert with Caregiver SMS">
            🔴 Critical Alert
          </button>
        </div>
      </div>

      <!-- Top-Right: Replaced Logo with Healthcare Badge & Logged-in Clinician Avatar -->
      <div class="flex items-center space-x-3">
        <!-- Patient View Quick Preview Link -->
        <a href="/patient/home" class="hidden sm:inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium text-[#737373] hover:text-[#171717] hover:bg-white border border-transparent hover:border-[#ebebeb] transition-all">
          <svg class="w-3.5 h-3.5 mr-1 text-[#0070f3]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
          Patient View
        </a>

        <!-- Doctor Avatar & Role Badge (Replaces Triangular Logo) -->
        <div class="flex items-center space-x-2.5 bg-white pl-2.5 pr-3 py-1 rounded-xl border border-[#ebebeb] shadow-xs">
          <!-- Healthcare Activity Badge -->
          <div class="w-7 h-7 rounded-lg bg-[#10b981]/15 flex items-center justify-center text-[#059669]">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
          </div>
          <div class="text-left">
            <div id="logged-in-user-name" class="text-xs font-bold text-[#171717] leading-tight">Dr. Alex Carter</div>
            <div id="logged-in-user-role" class="text-[10px] text-[#059669] font-medium leading-tight">Clinician • Lead Endocrinologist</div>
          </div>
          <!-- Logout Button -->
          <button id="btn-logout" class="ml-1 text-[11px] text-[#737373] hover:text-[#ee0000] p-1 rounded hover:bg-[#f5f5f5] transition-colors" title="Sign Out">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          </button>
        </div>
      </div>

    </div>
  </header>

  <!-- Mobile Presets Strip (shown only on small screens) -->
  <div class="md:hidden bg-white border-b border-[#ebebeb] px-4 py-2 flex items-center justify-between text-xs">
    <span class="text-[11px] font-mono text-[#737373]">Presets:</span>
    <div class="flex space-x-1.5">
      <button id="btn-scenario-stable-m" class="px-2 py-0.5 rounded text-[11px] bg-[#10b981]/10 text-[#059669]">🟢 Stable</button>
      <button id="btn-scenario-spike-m" class="px-2 py-0.5 rounded text-[11px] bg-[#f5a623]/15 text-[#d97706]">🟡 Spike</button>
      <button id="btn-scenario-critical-m" class="px-2 py-0.5 rounded text-[11px] bg-[#ee0000]/10 text-[#dc2626] font-bold">🔴 Critical</button>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed top-20 right-6 z-50 flex flex-col space-y-2 pointer-events-none max-w-md w-full"></div>

  <!-- MAIN VIEWPORT -->
  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">
    
    <!-- Top Overview Metrics Strip -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
      <div class="geist-card p-4">
        <div class="flex items-center justify-between">
          <span class="geist-eyebrow">Monitored Cohort</span>
          <span class="text-xs text-[#737373] font-mono">Continuous</span>
        </div>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-bold tracking-tight text-[#171717]" id="stat-total-patients">5</span>
          <span class="text-xs font-semibold text-[#059669] bg-[#10b981]/10 px-2 py-0.5 rounded">100% Consented</span>
        </div>
        <p class="text-xs text-[#737373] mt-1">Real-time wearable telemetry enabled</p>
      </div>

      <div class="geist-card p-4">
        <div class="flex items-center justify-between">
          <span class="geist-eyebrow">Urgent Triage</span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#ee0000] animate-pulse"></span>
        </div>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-bold tracking-tight text-[#ee0000]" id="stat-urgent-count">1</span>
          <span class="text-xs font-semibold text-[#ee0000] bg-[#ee0000]/10 px-2 py-0.5 rounded">Immediate Action</span>
        </div>
        <p class="text-xs text-[#737373] mt-1" id="stat-urgent-label">Eleanor Vance (P003) metabolic spike</p>
      </div>

      <div class="geist-card p-4">
        <div class="flex items-center justify-between">
          <span class="geist-eyebrow">Moderate Warnings</span>
          <span class="w-2.5 h-2.5 rounded-full bg-[#f5a623]"></span>
        </div>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-bold tracking-tight text-[#f5a623]" id="stat-moderate-count">2</span>
          <span class="text-xs font-semibold text-[#f5a623] bg-[#f5a623]/10 px-2 py-0.5 rounded">Lifestyle Warning</span>
        </div>
        <p class="text-xs text-[#737373] mt-1">Pre-diabetic glycemic elevations</p>
      </div>

      <div class="geist-card p-4">
        <div class="flex items-center justify-between">
          <span class="geist-eyebrow">AI Model Engine</span>
          <span class="text-xs font-mono text-[#0070f3] bg-[#0070f3]/10 px-1.5 py-0.5 rounded font-semibold">XGBoost v2</span>
        </div>
        <div class="mt-2 flex items-baseline justify-between">
          <span class="text-2xl font-bold tracking-tight text-[#171717]">95.3%</span>
          <span class="text-xs font-semibold text-[#059669] bg-[#10b981]/10 px-2 py-0.5 rounded">ROC-AUC</span>
        </div>
        <p class="text-xs text-[#737373] mt-1">SHAP TreeExplainer local attribution</p>
      </div>
    </div>

    <!-- Main Grid: Left Column (Triage Queue + Alerts) & Right Column (Patient Deep-Dive) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
      
      <!-- ============================================== -->
      <!-- LEFT COLUMN: Patient Triage Queue & Alerts     -->
      <!-- ============================================== -->
      <div class="lg:col-span-4 space-y-5">
        
        <!-- Patient Triage Queue Card -->
        <div class="geist-card p-4">
          <div class="flex items-center justify-between pb-3 border-b border-[#ebebeb]">
            <div>
              <h2 class="text-sm font-bold text-[#171717]">Patient Triage Queue</h2>
              <p class="text-[11px] text-[#737373]">Ranked dynamically by ML risk score</p>
            </div>
            <span class="text-[10px] font-mono text-[#059669] bg-[#10b981]/10 px-2 py-0.5 rounded font-semibold">Live Sort</span>
          </div>

          <!-- Search / Filter input -->
          <div class="mt-3 relative">
            <input id="input-search-patients" type="text" placeholder="Search patient by name or ID..." class="w-full px-3 py-1.5 text-xs rounded-lg border border-[#ebebeb] bg-[#fafafa] focus:outline-none focus:border-[#171717]" />
          </div>

          <!-- Dynamic Patient Cards List -->
          <div id="patient-triage-list" class="mt-3 space-y-2 max-h-[460px] overflow-y-auto pr-1">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Alert Feed & Audit Log Card -->
        <div class="geist-card p-4">
          <div class="flex items-center justify-between pb-2 border-b border-[#ebebeb]">
            <div>
              <h3 class="text-xs font-bold text-[#171717]">Alert Feed & Audit Log</h3>
              <p class="text-[10px] text-[#737373]">Multi-tier severity routing with timestamps</p>
            </div>
            <div class="flex space-x-1 text-[10px]">
              <button class="alert-filter-btn px-2 py-0.5 rounded bg-[#171717] text-white" data-filter="all">All</button>
              <button class="alert-filter-btn px-2 py-0.5 rounded bg-[#f2f2f2] text-[#4d4d4d]" data-filter="urgent">Urgent</button>
              <button class="alert-filter-btn px-2 py-0.5 rounded bg-[#f2f2f2] text-[#4d4d4d]" data-filter="moderate">Moderate</button>
            </div>
          </div>

          <div id="alert-feed-list" class="mt-3 space-y-2.5 max-h-80 overflow-y-auto pr-1">
            <!-- Dynamically populated alerts -->
          </div>
        </div>

      </div>

      <!-- ============================================== -->
      <!-- RIGHT COLUMN: Patient Deep-Dive Workspace       -->
      <!-- ============================================== -->
      <div class="lg:col-span-8 space-y-6">
        
        <!-- Active Patient Header Banner -->
        <div class="geist-card p-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pb-4 border-b border-[#ebebeb]">
            <div class="flex items-center space-x-4">
              <img id="active-patient-avatar" src="https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=150" alt="Avatar" class="w-14 h-14 rounded-full object-cover border-2 border-[#ebebeb] shadow-xs" />
              <div>
                <div class="flex items-center space-x-2.5">
                  <h2 id="active-patient-name" class="text-lg font-bold tracking-tight text-[#171717]">Eleanor Vance</h2>
                  <span id="active-patient-tier-badge" class="px-2.5 py-0.5 text-xs font-mono font-bold rounded-full bg-[#ee0000]/10 text-[#ee0000] border border-[#ee0000]/20">
                    URGENT TIER
                  </span>
                </div>
                <p class="text-xs text-[#737373] mt-0.5">
                  <span id="active-patient-id" class="font-mono font-semibold">P003</span> • 
                  <span id="active-patient-demographics">65 yrs • Female • BMI 34.6</span> • 
                  Doctor: <span class="text-[#171717] font-semibold">Dr. Alex Carter</span>
                </p>
              </div>
            </div>

            <!-- Risk Score Gauge -->
            <div class="flex items-center space-x-4 bg-[#fafafa] px-4 py-2.5 rounded-xl border border-[#ebebeb]">
              <div class="text-right">
                <div class="geist-eyebrow">ML Risk Score</div>
                <div id="active-patient-risk-score" class="text-2xl font-bold font-mono text-[#ee0000]">89.2%</div>
              </div>
              <div id="active-patient-risk-circle" class="w-12 h-12 rounded-full border-4 border-[#ee0000] flex items-center justify-center text-[10px] font-mono font-bold text-[#ee0000] bg-white">
                HIGH
              </div>
            </div>
          </div>

          <!-- Real-Time Vitals Ribbon -->
          <div class="mt-4 grid grid-cols-2 sm:grid-cols-4 gap-3">
            <div class="p-3 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
              <span class="geist-eyebrow">Blood Glucose</span>
              <div class="mt-1 flex items-baseline space-x-1.5">
                <span id="vital-glucose" class="text-2xl font-bold font-mono text-[#171717]">194.5</span>
                <span class="text-xs text-[#737373]">mg/dL</span>
              </div>
              <div id="vital-glucose-diff" class="text-[11px] font-mono text-[#ee0000] font-bold mt-0.5">+23.1% vs baseline</div>
            </div>

            <div class="p-3 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
              <span class="geist-eyebrow">Blood Pressure</span>
              <div class="mt-1 flex items-baseline space-x-1.5">
                <span id="vital-bp" class="text-2xl font-bold font-mono text-[#171717]">158/96</span>
                <span class="text-xs text-[#737373]">mmHg</span>
              </div>
              <div id="vital-bp-status" class="text-[11px] font-mono text-[#ee0000] mt-0.5">Stage 2 Hypertensive</div>
            </div>

            <div class="p-3 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
              <span class="geist-eyebrow">Heart Rate</span>
              <div class="mt-1 flex items-baseline space-x-1.5">
                <span id="vital-hr" class="text-2xl font-bold font-mono text-[#171717]">86</span>
                <span class="text-xs text-[#737373]">bpm</span>
              </div>
              <div id="vital-hr-diff" class="text-[11px] font-mono text-[#f5a623] mt-0.5">+10.2% vs baseline</div>
            </div>

            <div class="p-3 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
              <span class="geist-eyebrow">Blood Oxygen (SpO2)</span>
              <div class="mt-1 flex items-baseline space-x-1.5">
                <span id="vital-spo2" class="text-2xl font-bold font-mono text-[#171717]">94.2</span>
                <span class="text-xs text-[#737373]">%</span>
              </div>
              <div id="vital-spo2-status" class="text-[11px] font-mono text-[#f5a623] mt-0.5">Mild Hypoxia (94%)</div>
            </div>
          </div>
        </div>

        <!-- Interactive Vitals Trend Trajectory Chart -->
        <div class="geist-card p-5">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-3 border-b border-[#ebebeb] gap-2">
            <div>
              <h3 class="text-sm font-bold text-[#171717]">Vitals Trend Trajectory (Last 12 Hours)</h3>
              <p class="text-[11px] text-[#737373]">Continuous glucose telemetry plotted against personalized rolling baseline</p>
            </div>
            <div class="flex items-center space-x-2 text-xs">
              <span class="inline-flex items-center text-[11px] font-mono text-[#0070f3]">
                <span class="w-2.5 h-0.5 bg-[#0070f3] inline-block mr-1"></span> Personalized Baseline
              </span>
              <span class="inline-flex items-center text-[11px] font-mono text-[#ee0000]">
                <span class="w-2.5 h-0.5 bg-[#ee0000] inline-block mr-1"></span> Urgent Cutoff
              </span>
            </div>
          </div>

          <!-- SVG Chart -->
          <div class="mt-4">
            <svg id="vitals-chart-svg" class="w-full h-52 overflow-visible" viewBox="0 0 600 200"></svg>
          </div>
        </div>

        <!-- Clinical Explainability (XAI) & SHAP Contributions -->
        <div class="geist-card p-5">
          <div class="flex items-center justify-between pb-3 border-b border-[#ebebeb]">
            <div>
              <h3 class="text-sm font-bold text-[#171717]">Explainable AI (XAI) Clinical Insights</h3>
              <p class="text-[11px] text-[#737373]">SHAP TreeExplainer feature attributions explaining model risk score</p>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-mono bg-[#0070f3]/10 text-[#0070f3] font-semibold">SHAP XAI</span>
          </div>

          <!-- Plain Language Clinical Summary -->
          <div class="mt-3 p-3.5 rounded-xl bg-[#fafafa] border border-[#ebebeb]">
            <span class="geist-eyebrow">Clinical Summary</span>
            <p id="xai-plain-summary" class="text-xs text-[#171717] mt-1 leading-relaxed font-medium">
              <!-- Dynamically populated summary -->
            </p>
          </div>

          <!-- Top Contributing Feature Bars -->
          <div class="mt-4 space-y-2.5" id="shap-bars-container">
            <!-- Dynamically populated SHAP bars -->
          </div>

          <!-- Caregiver Dispatch Status Card (when urgent) -->
          <div id="caregiver-dispatch-status" class="mt-4 p-3.5 rounded-xl bg-[#ee0000]/5 border border-[#ee0000]/20 hidden">
            <div class="flex items-start space-x-2.5">
              <span class="w-2 h-2 rounded-full bg-[#ee0000] mt-1 shrink-0 animate-ping"></span>
              <div>
                <div class="text-xs font-bold text-[#ee0000]">Automated Emergency Caregiver Notification Dispatched</div>
                <p id="caregiver-dispatch-message" class="text-[11px] text-[#4d4d4d] mt-0.5 leading-relaxed"></p>
              </div>
            </div>
          </div>
        </div>

        <!-- Personalized Baseline vs Generic Population Comparison Table -->
        <div class="geist-card p-5">
          <h3 class="text-sm font-bold text-[#171717] pb-3 border-b border-[#ebebeb]">Personalized Baseline vs Clinical Norms</h3>
          <div class="mt-3 overflow-x-auto">
            <table class="w-full text-left text-xs font-mono">
              <thead>
                <tr class="text-[#737373] border-b border-[#ebebeb]">
                  <th class="pb-2 font-medium">Telemetry Metric</th>
                  <th class="pb-2 font-medium">Current Value</th>
                  <th class="pb-2 font-medium">Personal Baseline (EMA)</th>
                  <th class="pb-2 font-medium">Deviation</th>
                  <th class="pb-2 font-medium">Standard Clinical Norm</th>
                  <th class="pb-2 font-medium">Evaluation</th>
                </tr>
              </thead>
              <tbody id="baseline-comparison-table-body" class="divide-y divide-[#f5f5f5]">
                <!-- Dynamically populated -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- CLINICIAN ACTION DRAWER / INTERACTIVE NOTES PANEL -->
        <div class="geist-card p-5">
          <div class="flex items-center justify-between pb-3 border-b border-[#ebebeb]">
            <div>
              <h3 class="text-sm font-bold text-[#171717]">Clinician Actions & Triage Notes</h3>
              <p class="text-[11px] text-[#737373]">Record clinical evaluations, acknowledge alerts, and prescribe adjustments</p>
            </div>
            <span class="text-xs font-mono text-[#059669] bg-[#10b981]/10 px-2 py-0.5 rounded font-semibold">Audit Ready</span>
          </div>

          <!-- Quick Orders / Presets -->
          <div class="mt-3 flex flex-wrap gap-2 text-xs">
            <button class="btn-quick-note px-2.5 py-1 rounded-lg border border-[#ebebeb] bg-[#fafafa] hover:bg-[#f0f0f0] text-[#171717] transition-colors" data-note="Prescribed Metformin 500mg check. Advised continuous hydration and low-carb dinner.">
              💊 Check Metformin
            </button>
            <button class="btn-quick-note px-2.5 py-1 rounded-lg border border-[#ebebeb] bg-[#fafafa] hover:bg-[#f0f0f0] text-[#171717] transition-colors" data-note="Scheduled remote video consultation for tomorrow 10:00 AM. Caregiver notified.">
              📹 Schedule Tele-Consult
            </button>
            <button class="btn-quick-note px-2.5 py-1 rounded-lg border border-[#ebebeb] bg-[#fafafa] hover:bg-[#f0f0f0] text-[#171717] transition-colors" data-note="Ordered emergency laboratory panel: HbA1c, fasting lipids, and renal electrolytes.">
              🧪 Order HbA1c Panel
            </button>
          </div>

          <!-- Note Input Field -->
          <div class="mt-3 space-y-2">
            <textarea id="clinician-note-input" rows="2" placeholder="Type clinical note or triage order here..." class="w-full px-3 py-2 text-xs rounded-xl border border-[#ebebeb] bg-[#fafafa] focus:outline-none focus:border-[#171717] focus:bg-white"></textarea>
            
            <div class="flex items-center justify-between">
              <span id="note-save-status" class="text-[11px] font-mono text-[#059669]"></span>
              <div class="flex space-x-2">
